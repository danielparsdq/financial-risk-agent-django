# Copiar a sistema_xia/.env y completar. No subir .env al repositorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Proveedor LLM compatible con la API de OpenAI (debe incluir /v1)
# Ejemplo con Ollama local: ollama serve
LLM_HOST=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
# Modelo del chatbot: debe soportar tool calling
LLM_MODEL=gemma2:9b
# Modelo del agente auditor: debe soportar response_format json_object
AUDIT_LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
